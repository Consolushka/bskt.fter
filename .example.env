# DB
DB_HOST=localhost
DB_DRIVER=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=imp
DB_PORT=5432

# GOOSE
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/imp?sslmode=disable
GOOSE_MIGRATION_DIR=./app/database/migrations

# LOGGER (actually used in code)
LOGGER_CONSOLE_ENABLED=true
LOGGER_CONSOLE_LEVEL=info
LOGGER_FILE_ENABLED=false
LOGGER_FILE_PATH=tmp/logs/app.log
LOGGER_FILE_LEVEL=info
LOGGER_TELEGRAM_ENABLED=false
LOGGER_TELEGRAM_TOKEN=
LOGGER_TELEGRAM_CHAT_ID=0
LOGGER_TELEGRAM_LEVEL=warn

# API-SPORTS
API_SPORT_API_KEY=

# AGGREGATOR
WEBHOOK_AGGREGATOR_HOST=http://localhost:8081
# shared secret, тот же что AGGREGATOR_API_TOKEN у API; пустой — заголовок не шлётся
WEBHOOK_AGGREGATOR_TOKEN=

# Rate limits (requests per minute)
ESPN_RATE_LIMIT_PER_MINUTE=60
API_NBA_RATE_LIMIT_PER_MINUTE=10
INFOBASKET_RATE_LIMIT_PER_MINUTE=25
SPORTOTEKA_RATE_LIMIT_PER_MINUTE=25

# Scheduler
SCHEDULER_POLL_INTERVAL=30
SCHEDULER_STAGGER_INTERVAL_MINUTES=5
SCHEDULER_REFRESH_INTERVAL_MINUTES=5
